FROM rust:1.96.1-bookworm@sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663
ARG RUST_TARGET=aarch64-unknown-linux-musl
RUN apt-get update && apt-get install -y --no-install-recommends musl-tools git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add "$RUST_TARGET"
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C target-feature=+crt-static -C relocation-model=static"
ENV CARGO_BUILD_JOBS=2
WORKDIR /src
